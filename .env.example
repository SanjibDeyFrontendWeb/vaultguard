# VaultGuard Environment Configuration
# MongoDB Atlas Connection URI
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/vaultguard?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/vaultguard

# Session Cookie & Auth Encryption Secret (64+ hex characters)
SESSION_SECRET=vaultguard_super_secure_production_ready_session_secret_key_32bytes_minimum_length_required!

# Application Environment
NODE_ENV=development

# Cookie domain / security
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Super Admin Portal Credentials
SUPER_ADMIN_EMAIL=admin@vaultguard.com
SUPER_ADMIN_PASSWORD=Admin@VaultGuard2026!
